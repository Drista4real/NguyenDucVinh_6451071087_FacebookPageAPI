{
  "Facebook": {
    "BaseUrl": "https://graph.facebook.com",
    "ApiVersion": "v25.0",
    "PageAccessToken": "",
    "DefaultPageId": "",
    "TimeoutSeconds": 30
  },
  "Dashboard": {
    "ApiKey": ""
  },
  "CircuitBreaker": {
    "FailureThreshold": 5,
    "OpenSeconds": 30,
    "ReadRetryCount": 3
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "ConsumerGroup": "backend-api",
    "ReplyCommandsTopic": "reply_commands",
    "SendRetryTopic": "send_retry",
    "SendFailedTopic": "send_failed"
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=fb_api_db;Username=fb_api_user;Password=fb_api_password"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
