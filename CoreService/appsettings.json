{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerGroupId": "core-service-group",
    "Topics": {
      "RawEvents": "raw_events",
      "ReplyCommands": "reply_commands"
    }
  },
  "AiApi": {
    "Provider": "OpenAI",
    "OpenAi": {
      "BaseUrl": "https://api.openai.com/v1/",
      "ApiKey": "",
      "Model": "gpt-5.4-mini",
      "TimeoutSeconds": 10,
      "MaxOutputTokens": 200
    }
  },
  "Moderation": {
    "ProcessingLeaseMinutes": 5,
    "RateLimitWindowSeconds": 60,
    "RateLimitMaxComments": 20,
    "BlacklistWindowHours": 24,
    "BlacklistSpamThreshold": 3
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=fb_api_db;Username=fb_api_user;Password=fb_api_password"
  }
}
