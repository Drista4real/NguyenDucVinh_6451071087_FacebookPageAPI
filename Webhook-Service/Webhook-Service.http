@WebhookService_HostAddress = http://localhost:3001
@VerifyToken = replace-with-webhook-verify-token

GET {{WebhookService_HostAddress}}/health
Accept: application/json

###

GET {{WebhookService_HostAddress}}/webhook?hub.mode=subscribe&hub.verify_token={{VerifyToken}}&hub.challenge=challenge-123
Accept: text/plain

###

# Generate X-Hub-Signature-256 from the exact raw JSON body using the App Secret.
POST {{WebhookService_HostAddress}}/webhook
Content-Type: application/json
X-Hub-Signature-256: sha256=replace-with-hmac-sha256

{
  "object": "page",
  "entry": [
    {
      "id": "page-123",
      "time": 1780710000,
      "changes": [
        {
          "field": "feed",
          "value": {
            "item": "comment",
            "verb": "add",
            "comment_id": "comment-456",
            "post_id": "post-789",
            "sender_id": "user-101",
            "sender_name": "Nguyen Van A",
            "message": "Shop oi gia bao nhieu?",
            "created_time": 1780710001
          }
        }
      ]
    }
  ]
}
